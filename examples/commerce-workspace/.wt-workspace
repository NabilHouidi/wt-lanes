# Example wt workspace configuration.
# This file is sourced by wt, so keep it to plain shell assignments.

# Pin the repositories wt manages. Delete this line to auto-discover every
# direct child directory that is a Git repository.
REPOS=(checkout-api checkout-web shared-events)

# Base branch for new feature branches. Unset to use each repo's origin/HEAD.
DEFAULT_BASE=origin/main

# Rename the generated lane guide, or set it empty to disable generation.
# LANE_GUIDE=CLAUDE.md
