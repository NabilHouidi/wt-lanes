#!/usr/bin/env bash
# wt — multi-repo worktree lanes for meta-project workspaces

set -euo pipefail

usage() {
  cat <<'EOF'
wt — multi-repo worktree lanes for meta-project workspaces

Usage:
  wt create <feature> [repo...]   create a lane (all repos if none given)
  wt cleanup <feature>            remove a lane's worktrees and branches
  wt list (or ls)                 show lanes and per-repo status
  wt path <feature>               print a lane's directory
  wt help                         show this help

Rerunning create restores missing lane files and never overwrites existing
ones. Cleanup removes the lane's worktrees, merged branches, every file wt
placed and the IDE state in .idea/; it lists uncommitted changes, edited or
added files in template copies, and shelved IDE changes first and asks before
deleting them. Other files wt did not place (notes, .tmp/) stay.
EOF
}

# --- workspace discovery -----------------------------------------------------
WORKSPACE_ROOT=""
REPOS=()
WT_DIR=""
LANE_TMPL=""
REPO_TMPL=""

# walk up from $PWD to the nearest .wt/workspace.sh marker
find_workspace_root() {
  local dir="$PWD"
  while [ "$dir" != "/" ]; do
    if [ -f "$dir/.wt/workspace.sh" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    if [ -f "$dir/.wt-workspace" ]; then
      cat >&2 <<EOF
error: $dir uses the old layout (.wt-workspace, .wt-templates/). Migrate with:
  cd "$dir"
  mkdir -p .wt/repos && mv .wt-workspace .wt/workspace.sh
  if [ -d .wt-templates ]; then
    if [ -d .wt-templates/_lane ]; then mv .wt-templates/_lane .wt/lane_root; fi
    for d in .wt-templates/*/; do if [ -d "\$d" ]; then mv "\$d" .wt/repos/; fi; done
    if [ -f .wt-templates/README.md ]; then mv .wt-templates/README.md .wt/; fi
    rmdir .wt-templates
  fi
EOF
      return 1
    fi
    dir=$(dirname "$dir")
  done
  echo "error: not inside a wt workspace (no .wt/workspace.sh found)" >&2
  return 1
}

# locate the workspace, source its config, resolve derived paths
init_workspace() {
  WORKSPACE_ROOT=$(find_workspace_root) || return 1

  # Optional per-workspace overrides, plain shell:
  #   REPOS=(repoA repoB)             pin the repo list
  #   DEFAULT_BASE=origin/master      base branch for new feature branches
  # shellcheck disable=SC1091
  if [ -s "$WORKSPACE_ROOT/.wt/workspace.sh" ]; then
    # shellcheck disable=SC1091
    source "$WORKSPACE_ROOT/.wt/workspace.sh"
  fi

  # REPOS unset: auto-discover child directories that are repository roots
  if [ -z "${REPOS+x}" ]; then
    REPOS=()
    local d
    for d in "$WORKSPACE_ROOT"/*/; do
      d=${d%/}
      if is_repo_root "$d"; then
        REPOS+=("$(basename "$d")")
      fi
    done
  fi

  WT_DIR="$WORKSPACE_ROOT/.worktrees"
  local resolved
  if resolved=$(realpath -m -- "$WT_DIR" 2>/dev/null); then
    WT_DIR=$resolved
  fi

  LANE_TMPL="$WORKSPACE_ROOT/.wt/lane_root"
  REPO_TMPL="$WORKSPACE_ROOT/.wt/repos"
}

# --- path and worktree helpers ------------------------------------------------
# true when any /-separated component is empty, . or ..
has_unsafe_path_component() {
  local path="$1" part rest
  while :; do
    if [[ "$path" == */* ]]; then
      part=${path%%/*}
      rest=${path#*/}
      case "$part" in
        "" | "." | "..") return 0 ;;
      esac
      path=$rest
    else
      case "$path" in
        "" | "." | "..") return 0 ;;
      esac
      return 1
    fi
  done
}

# simple directory name: no slashes, no . .. or leading dash
is_repo_name() {
  local repo="$1"
  case "$repo" in
    "" | "." | ".." | -* | */*) return 1 ;;
    *) return 0 ;;
  esac
}

# is_repo_name, with an error message
validate_repo_name() {
  local repo="$1"
  if ! is_repo_name "$repo"; then
    echo "error: invalid repository name: '$repo'" >&2
    return 1
  fi
}

# feature must be a safe relative path and valid branch name
validate_feature_name() {
  local feature="$1"
  if [ -z "$feature" ] || [ "${feature:0:1}" = "/" ] || [ "${feature:0:1}" = "-" ]; then
    echo "error: invalid feature name: '$feature'" >&2
    return 1
  fi
  if has_unsafe_path_component "$feature"; then
    echo "error: invalid feature name: '$feature'" >&2
    return 1
  fi
  if ! git check-ref-format --branch "$feature" >/dev/null 2>&1; then
    echo "error: invalid feature name: '$feature'" >&2
    return 1
  fi
}

# print the lane dir, refusing anything that escapes .worktrees
lane_dir_for() {
  local feature="$1"
  validate_feature_name "$feature" || return 1

  local dir="$WT_DIR/$feature"
  local root candidate
  # canonicalize when realpath is available; otherwise trust the validated name
  if root=$(realpath -- "$WT_DIR" 2>/dev/null) &&
    candidate=$(realpath -m -- "$dir" 2>/dev/null); then
    case "$candidate" in
      "$root")
        echo "error: feature resolves to the worktree directory itself" >&2
        return 1
        ;;
      "$root"/*) dir=$candidate ;;
      *)
        echo "error: feature resolves outside the worktree directory: '$feature'" >&2
        return 1
        ;;
    esac
  fi

  printf '%s\n' "$dir"
}

# true if target is registered in main's worktree list
worktree_belongs_to_main() {
  local main="$1" target="$2"
  git -C "$main" worktree list --porcelain 2>/dev/null |
    grep -Fx "worktree $target" >/dev/null
}

# linked worktree of main, currently on branch <feature>
is_feature_worktree() {
  local main="$1" target="$2" feature="$3"
  [ -f "$target/.git" ] || return 1
  is_repo_root "$target" || return 1
  [ "$(git -C "$target" branch --show-current 2>/dev/null)" = "$feature" ] || return 1
  worktree_belongs_to_main "$main" "$target"
}

# true if dir is a git worktree top level (empty --show-cdup)
is_repo_root() {
  local dir="$1" cdup
  [ -d "$dir" ] || return 1
  cdup=$(git -C "$dir" rev-parse --show-cdup 2>/dev/null) || return 1
  [ -z "$cdup" ]
}

# per-repo default branch, override with DEFAULT_BASE
base_branch_for() {
  local main="$1"
  if [ -n "${DEFAULT_BASE:-}" ]; then
    echo "$DEFAULT_BASE"
    return
  fi
  local ref
  ref=$(git -C "$main" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) ||
    {
      echo "origin/main"
      return
    }
  echo "${ref#refs/remotes/}"
}

LANE_COLORS=(
  "#2E5EAA" # blue
  "#1E6F5C" # teal
  "#B5451B" # burnt orange
  "#6A4C93" # purple
  "#A02334" # brick red
  "#2C6E49" # forest green
  "#8A5A00" # amber/brown
  "#3D5A80" # slate blue
  "#7A3E65" # plum
  "#4C6444" # olive
)

# deterministic pick from LANE_COLORS, keyed by feature name
lane_color() {
  local input="$1" hash
  if command -v md5sum >/dev/null 2>&1; then
    hash=$(printf '%s' "$input" | md5sum | cut -c1-8)
  elif command -v md5 >/dev/null 2>&1; then
    hash=$(printf '%s' "$input" | md5 -q | cut -c1-8)
  else
    hash=$(printf '%08x' "$(printf '%s' "$input" | cksum | cut -d' ' -f1)")
  fi
  local idx=$((0x$hash % ${#LANE_COLORS[@]}))
  echo "${LANE_COLORS[$idx]}"
}

# print the lane's .code-workspace, colored by feature name
workspace_file_body() {
  local color
  color=$(lane_color "$1")

  # One folder entry, the lane root itself: lane-level docs (AGENTS.md,
  # HANDOVER.md, DESIGN.md, findings) are only reachable in the explorer if the
  # root is a workspace folder. The repos appear as its subfolders. Listing the
  # repos as folders *as well* would show every file twice in Quick Open.
  echo '{'
  echo '  "folders": ['
  echo '    { "path": "." }'
  echo '  ],'
  echo '  "settings": {'
  echo '    "workbench.colorCustomizations": {'
  printf '      "titleBar.activeBackground": "%s",\n' "$color"
  printf '      "titleBar.activeForeground": "#ffffff",\n'
  printf '      "activityBar.background": "%s",\n' "$color"
  printf '      "statusBar.background": "%s"\n' "$color"
  echo '    }'
  echo '  }'
  echo '}'
}

# write the lane's <name>.code-workspace unless one exists
generate_workspace_file() {
  local feature="$1" feat_dir="$2"
  local out
  out="$feat_dir/$(basename "$feature").code-workspace"
  if [ ! -e "$out" ]; then
    workspace_file_body "$feature" >"$out"
  fi
}

# print files under dst that differ from their template copy in src;
# files only in dst (IDE state, new files) are not reported
changed_copies() {
  local src="$1" dst="$2" f
  if [ ! -d "$src" ] || [ ! -d "$dst" ]; then
    return 0
  fi
  while IFS= read -r -d '' f; do
    f=${f#"$src"/}
    if [ -f "$dst/$f" ] && ! cmp -s -- "$src/$f" "$dst/$f"; then
      printf '%s\n' "$dst/$f"
    fi
  done < <(find "$src" -type f -print0)
}

# print files a lane added inside its copies of lane template directories;
# .idea/ is IDE state and is not reported
added_in_lane_copies() {
  local feat_dir="$1" line dir
  while IFS= read -r line; do
    dir=${line#Only in }
    dir=${dir%%: *}
    case "$dir" in
      "$feat_dir" | "$feat_dir/.idea" | "$feat_dir/.idea/"*) ;;
      "$feat_dir/"*) printf '%s/%s\n' "$dir" "${line#*: }" ;;
    esac
  done < <(diff -r -q -- "$LANE_TMPL" "$feat_dir" 2>/dev/null | grep -F "Only in $feat_dir" || true)
}

# remove a lane dir and its now-empty parents up to .worktrees; false if not empty
remove_lane_dir() {
  local dir="$1"
  rmdir -- "$dir" 2>/dev/null || return 1
  dir=$(dirname "$dir")
  while [ "$dir" != "$WT_DIR" ] && rmdir -- "$dir" 2>/dev/null; do
    dir=$(dirname "$dir")
  done
}

# print each lane root under a dir, NUL-separated, without descending into
# worktrees or lanes (lanes cannot nest: git refuses branches foo and foo/bar)
find_lanes() {
  local d
  for d in "$1"/*/; do
    d=${d%/}
    if [ ! -d "$d" ] || [ -L "$d" ] || [ -f "$d/.git" ]; then
      continue
    fi
    if [ -f "$d/.wt-lane" ]; then
      printf '%s\0' "$d"
    else
      find_lanes "$d"
    fi
  done
}

# copy repo templates into a worktree (overwrite=0 keeps existing files), then direnv
apply_repo_scaffolding() {
  local target="$1" repo="$2" overwrite="$3"

  # static scaffolding from templates (.run/, .vscode/, .envrc)
  if [ -d "$REPO_TMPL/$repo" ]; then
    if [ "$overwrite" -eq 1 ]; then
      cp -r -- "$REPO_TMPL/$repo/." "$target/"
    else
      cp -rn -- "$REPO_TMPL/$repo/." "$target/"
    fi
  fi

  # trust the envrc this script just placed
  if [ -f "$target/.envrc" ] && command -v direnv >/dev/null 2>&1; then
    direnv allow "$target"
  fi
}

# --- subcommands --------------------------------------------------------------
# create or repair a lane: worktrees, scaffolding, workspace
cmd_create() {
  local feature="${1:?usage: wt create <feature> [repo...]}"
  shift
  init_workspace || return 1

  local repos=()
  if [ "$#" -gt 0 ]; then
    repos=("$@")
  fi
  if [ ${#repos[@]} -eq 0 ]; then
    repos=("${REPOS[@]+"${REPOS[@]}"}")
  fi
  for repo in "${repos[@]+"${repos[@]}"}"; do
    validate_repo_name "$repo" || return 1
  done

  local feat_dir
  feat_dir=$(lane_dir_for "$feature") || return 1

  if [ -e "$feat_dir" ] && [ ! -d "$feat_dir" ]; then
    echo "error: lane path is not a directory: $feat_dir" >&2
    return 1
  fi

  local marker_existed=0
  if [ -f "$feat_dir/.wt-lane" ]; then
    local stored
    stored=$(cat "$feat_dir/.wt-lane" 2>/dev/null) || stored=""
    if [ "$stored" != "$feature" ]; then
      echo "error: existing lane at $feat_dir belongs to '$stored', not '$feature'" >&2
      return 1
    fi
    marker_existed=1
  fi

  # git refuses branch foo next to foo/bar, but only after the marker below is
  # written; a stray marker would hide the other lane from list and cleanup
  local parent="$feat_dir" inner
  while parent=$(dirname "$parent") && [ "$parent" != "$WT_DIR" ] && [ "$parent" != "/" ]; do
    if [ -f "$parent/.wt-lane" ]; then
      echo "error: $feat_dir is inside lane '${parent#"$WT_DIR"/}'" >&2
      return 1
    fi
  done
  if [ -d "$feat_dir" ]; then
    inner=$(find_lanes "$feat_dir" | tr '\0' '\n')
    if [ -n "$inner" ]; then
      inner=${inner%%$'\n'*}
      echo "error: $feat_dir contains lane '${inner#"$WT_DIR"/}'" >&2
      return 1
    fi
  fi

  # lane marker first, so a create that fails partway still leaves a lane that
  # `wt list` and `wt cleanup` can find. Tools also walk up to it to find the
  # lane root; durable scratch/work product belongs in the lane, not /tmp.
  mkdir -p -- "$feat_dir"
  printf '%s\n' "$feature" >"$feat_dir/.wt-lane"

  local created=()
  for repo in "${repos[@]+"${repos[@]}"}"; do
    local main="$WORKSPACE_ROOT/$repo"
    local target="$feat_dir/$repo"

    if ! is_repo_root "$main"; then
      echo "skip $repo (not a git repo)"
      continue
    fi

    if [ -e "$target" ] || [ -L "$target" ]; then
      # valid existing worktree: restore missing scaffolding, keep existing files
      if is_feature_worktree "$main" "$target" "$feature"; then
        echo "repair $repo (worktree exists)"
        # ||: keeps errexit off inside; cp -n exits 1 on skipped files in
        # GNU coreutils 9.2-9.4, which must not abort the repair
        apply_repo_scaffolding "$target" "$repo" 0 || return 1
        created+=("$repo")
        continue
      fi
      echo "error: $target exists but is not a valid '$feature' worktree for $repo" >&2
      return 1
    fi

    echo "==> $repo"
    if ! git -C "$main" fetch origin --quiet 2>/dev/null; then
      echo "    warning: could not fetch origin in $repo; the base may be stale" >&2
    fi

    # attach an existing local branch (review/hotfix flows); else branch from base
    if git -C "$main" show-ref --verify --quiet "refs/heads/$feature"; then
      git -C "$main" worktree add "$target" "$feature"
    else
      local base
      base=$(base_branch_for "$main")
      if ! git -C "$main" rev-parse --verify --quiet "$base" >/dev/null; then
        echo "    warning: $base not found in $repo; branching from its current HEAD" >&2
        base=HEAD
      fi
      git -C "$main" worktree add "$target" -b "$feature" "$base"
    fi

    apply_repo_scaffolding "$target" "$repo" 1

    created+=("$repo")
  done

  if [ ${#created[@]} -eq 0 ]; then
    echo "error: no worktrees created" >&2
    if [ "$marker_existed" -eq 0 ]; then
      rm -f -- "$feat_dir/.wt-lane"
      remove_lane_dir "$feat_dir" || true
    fi
    return 1
  fi

  # lane-level scaffolding; -n keeps every file the lane already has
  if [ -d "$LANE_TMPL" ]; then
    find "$LANE_TMPL" -mindepth 1 -maxdepth 1 ! \( -type f -name '*.tmpl' \) \
      -exec cp -rn -- {} "$feat_dir/" \;
  elif [ ! -d "$REPO_TMPL" ]; then
    echo "note: no .wt/lane_root/ or .wt/repos/ in $WORKSPACE_ROOT; lane has no scaffolding"
  fi
  if [ -f "$feat_dir/.envrc" ] && command -v direnv >/dev/null 2>&1; then
    direnv allow "$feat_dir"
  fi

  # IDE project name = product/workspace name (payments, search, …) instead of the
  # lane folder; the branch widget already shows the lane. Skip if one exists.
  if [ -d "$feat_dir/.idea" ] && [ ! -f "$feat_dir/.idea/.name" ]; then
    basename "$WORKSPACE_ROOT" >"$feat_dir/.idea/.name"
  fi

  generate_workspace_file "$feature" "$feat_dir"

  echo
  local workspace_file
  workspace_file="$feat_dir/$(basename "$feature").code-workspace"
  echo "ready: $feat_dir"
  echo "  workspace: $workspace_file"
  if command -v code >/dev/null 2>&1; then
    echo "  code \"$workspace_file\""
  fi
}

# remove a lane's worktrees, merged branches and the files wt placed, after
# confirming any uncommitted or edited work that would go with them
cmd_cleanup() {
  local feature="${1:?usage: wt cleanup <feature>}"
  init_workspace || return 1

  local feat_dir
  feat_dir=$(lane_dir_for "$feature") || return 1

  if [ ! -d "$feat_dir" ]; then
    echo "error: no lane at $feat_dir" >&2
    return 1
  fi

  # without a marker this may be a parent of other lanes, not a lane
  if [ ! -f "$feat_dir/.wt-lane" ]; then
    echo "error: $feat_dir is not a lane (no .wt-lane)" >&2
    return 1
  fi
  local stored
  stored=$(cat "$feat_dir/.wt-lane" 2>/dev/null) || stored=""
  if [ "$stored" != "$feature" ]; then
    echo "error: lane at $feat_dir belongs to '$stored', not '$feature'" >&2
    return 1
  fi

  # discover repos from the lane itself, not the current REPOS config
  local discovered=()
  while IFS= read -r -d '' gitfile; do
    local repo_dir
    repo_dir=$(dirname "$gitfile")
    if [ "$(dirname "$repo_dir")" = "$feat_dir" ]; then
      local repo
      repo=$(basename "$repo_dir")
      if is_repo_name "$repo"; then
        discovered+=("$repo")
      fi
    fi
  done < <(find "$feat_dir" -mindepth 2 -maxdepth 2 -name .git -type f -print0)

  # preflight: verify linkage and collect work that exists nowhere else
  local failed=() risks=() line
  if [ ${#discovered[@]} -gt 0 ]; then
    for repo in "${discovered[@]+"${discovered[@]}"}"; do
      local main="$WORKSPACE_ROOT/$repo"
      local target="$feat_dir/$repo"

      if ! is_repo_root "$main"; then
        echo "error: main repository not found at $main" >&2
        failed+=("$repo")
        continue
      fi

      if ! is_repo_root "$target"; then
        echo "error: lane path is not a valid repository: $target" >&2
        failed+=("$repo")
        continue
      fi

      if ! worktree_belongs_to_main "$main" "$target"; then
        echo "error: lane path is not linked to $main: $target" >&2
        failed+=("$repo")
        continue
      fi

      local status
      status=$(git -C "$target" status --porcelain --untracked-files=all 2>/dev/null) || {
        echo "error: cannot inspect lane worktree: $target" >&2
        failed+=("$repo")
        continue
      }

      while IFS= read -r line; do
        # untracked template copies are checked against their template below
        if [ -z "$line" ] ||
          { [ "${line:0:2}" = "??" ] && [ -f "$REPO_TMPL/$repo/${line:3}" ]; }; then
          continue
        fi
        risks+=("$repo/${line:3} (uncommitted)")
      done <<<"$status"

      while IFS= read -r line; do
        risks+=("${line#"$feat_dir"/} (edited template copy)")
      done < <(changed_copies "$REPO_TMPL/$repo" "$target")
    done
  fi

  if [ ${#failed[@]} -gt 0 ]; then
    echo "error: cleanup preflight failed; no worktrees were removed" >&2
    return 1
  fi

  local ws_file
  ws_file="$feat_dir/$(basename "$feature").code-workspace"
  if [ -f "$ws_file" ] && ! workspace_file_body "$feature" | cmp -s - "$ws_file"; then
    risks+=("${ws_file#"$feat_dir"/} (edited)")
  fi
  while IFS= read -r line; do
    risks+=("${line#"$feat_dir"/} (edited template copy)")
  done < <(changed_copies "$LANE_TMPL" "$feat_dir")
  while IFS= read -r line; do
    risks+=("${line#"$feat_dir"/} (added to a template copy)")
  done < <(added_in_lane_copies "$feat_dir")
  if [ -n "$(ls -A "$feat_dir/.idea/shelf" 2>/dev/null)" ]; then
    risks+=(".idea/shelf (shelved IDE changes)")
  fi

  if [ ${#risks[@]} -gt 0 ]; then
    echo "warning: cleanup would delete work that exists nowhere else:" >&2
    printf '  %s\n' "${risks[@]}" >&2
    if [ ! -t 0 ]; then
      echo "error: cannot confirm without a terminal; nothing was removed" >&2
      return 1
    fi
    local answer=""
    read -r -p "Delete it anyway? [y/N] " answer || true
    case "$answer" in
      y | Y | yes) ;;
      *)
        echo "nothing was removed"
        return 1
        ;;
    esac
  fi

  if [ ${#discovered[@]} -gt 0 ]; then
    for repo in "${discovered[@]+"${discovered[@]}"}"; do
      local main="$WORKSPACE_ROOT/$repo"
      local target="$feat_dir/$repo"

      echo "==> $repo"
      # --force: anything it would discard was listed and confirmed above
      if git -C "$main" worktree remove --force "$target" &&
        git -C "$main" worktree prune; then
        git -C "$main" branch -d "$feature" 2>/dev/null ||
          echo "    branch $feature kept (unmerged or absent)"
      else
        echo "    remove failed (dirty or invalid worktree)" >&2
        failed+=("$repo")
      fi
    done
  fi

  if [ ${#failed[@]} -gt 0 ]; then
    echo "error: cleanup incomplete; lane left in place" >&2
    return 1
  fi

  # remove what wt placed in the lane root; files it did not place stay, and
  # the markers go last so a lane that keeps files stays findable as a lane
  local entry name kept=()
  while IFS= read -r -d '' entry; do
    name=${entry#"$feat_dir"/}
    case "$name" in
      .wt-lane | .wt-lane-manifest) continue ;; # manifest: left by older versions
      .idea | "$(basename "$ws_file")") ;;      # .idea: IDE state, template or not
      *) [ -e "$LANE_TMPL/$name" ] || { kept+=("$name"); continue; } ;;
    esac
    rm -rf -- "$entry"
  done < <(find "$feat_dir" -mindepth 1 -maxdepth 1 -print0)

  if [ ${#kept[@]} -gt 0 ]; then
    echo "note: worktrees removed; kept lane files that wt did not create:"
    printf '  %s\n' "${kept[@]}"
    echo "  when done with them: rm -rf \"$feat_dir\""
    return 0
  fi

  rm -f -- "$feat_dir/.wt-lane" "$feat_dir/.wt-lane-manifest"
  remove_lane_dir "$feat_dir" || echo "note: $feat_dir not empty, left in place"
}

# print every lane's repos with branch, dirty count, origin delta
cmd_list() {
  init_workspace || return 1

  if [ ! -d "$WT_DIR" ]; then
    echo "no lanes"
    return 0
  fi

  # lanes are found by their .wt-lane marker, at any nesting depth
  local found=0
  while IFS= read -r -d '' lane_dir; do
    local actual="${lane_dir#"$WT_DIR"/}"
    local stored
    stored=$(cat "$lane_dir/.wt-lane" 2>/dev/null) || continue
    if [ "$stored" != "$actual" ] || ! validate_feature_name "$stored" >/dev/null 2>&1; then
      continue
    fi

    while IFS= read -r -d '' gitfile; do
      local repo_dir
      repo_dir=$(dirname "$gitfile")
      if [ "$(dirname "$repo_dir")" != "$lane_dir" ]; then
        continue
      fi

      local repo
      repo=$(basename "$repo_dir")
      if ! is_repo_name "$repo"; then
        continue
      fi

      found=1
      local branch dirty ahead_behind
      branch=$(git -C "$repo_dir" branch --show-current)
      dirty=$(git -C "$repo_dir" status --porcelain | wc -l)
      ahead_behind=$(git -C "$repo_dir" rev-list --left-right --count \
        "origin/$branch...HEAD" 2>/dev/null | awk '{print "-"$1" +"$2}') || ahead_behind="?"
      printf '%-30s %-15s %-25s %3s dirty  %s\n' \
        "$stored" "$repo" "$branch" "$dirty" "$ahead_behind"
    done < <(find "$lane_dir" -mindepth 2 -maxdepth 2 -name .git -type f -print0)
  done < <(find_lanes "$WT_DIR")

  if [ "$found" -eq 0 ]; then
    echo "no lanes"
  fi
}

# print a lane's directory (for cd "$(wt path ...)")
cmd_path() {
  local feature="${1:?usage: wt path <feature>}"
  init_workspace || return 1

  local feat_dir
  feat_dir=$(lane_dir_for "$feature") || return 1
  if [ ! -d "$feat_dir" ]; then
    echo "error: no lane at $feat_dir" >&2
    return 1
  fi
  echo "$feat_dir"
}

# --- dispatch ------------------------------------------------------------------
case "${1:-}" in
  create)
    shift
    cmd_create "$@"
    ;;
  cleanup)
    shift
    cmd_cleanup "$@"
    ;;
  list | ls)
    shift
    cmd_list "$@"
    ;;
  path)
    shift
    cmd_path "$@"
    ;;
  help | -h | --help)
    shift
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac
